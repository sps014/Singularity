public fun find_track(catalog: Track[], id: string): Option<Track> {
    for (let track in catalog) {
        if track.id == id {
            return Option.Some(track);
        }
    }
    return Option.None;
}

public fun search_tracks(catalog: Track[], query: string): List<Track> {
    let matches = List<Track>();
    let term = query.trim().to_lower();
    for (let track in catalog) {
        if term
            == ""
            || (track.title + " " + track.artist + " " + track.album)
            .to_lower()
            .contains(term) {
            matches.push(track);
        }
    }
    return matches;
}

public fun search_playlists(playlists: List<Playlist>, query: string): List<Playlist> {
    let matches = List<Playlist>();
    let term = query.trim().to_lower();
    for (let playlist in playlists) {
        if term == "" || playlist.name.to_lower().contains(term) {
            matches.push(playlist);
        }
    }
    return matches;
}
