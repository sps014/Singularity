module common;

import system;
import system.collections;
import system.json;

@json
public class Track {
    public id: string;
    public title: string;
    public artist: string;
    public album: string;
    public url: string;
    public artwork: string;
    public mood: string;

    public constructor(
        id: string,
        title: string,
        artist: string,
        album: string,
        url: string,
        artwork: string,
        mood: string
    ) {
        this.id = id;
        this.title = title;
        this.artist = artist;
        this.album = album;
        this.url = url;
        this.artwork = artwork;
        this.mood = mood;
    }
}

public fun track_value(track: Track): JsonValue {
    let value = JsonValue.dict();
    value["id"] = JsonValue.from_string(track.id);
    value["title"] = JsonValue.from_string(track.title);
    value["artist"] = JsonValue.from_string(track.artist);
    value["album"] = JsonValue.from_string(track.album);
    value["url"] = JsonValue.from_string(track.url);
    value["artwork"] = JsonValue.from_string(track.artwork);
    value["mood"] = JsonValue.from_string(track.mood);
    return value;
}

public class Playlist {
    public id: string;
    public name: string;
    public tracks: List<string>;

    public constructor(id: string, name: string) {
        this.id = id;
        this.name = name;
        this.tracks = List<string>();
    }

    public fun add(track_id: string): bool {
        if this.tracks.contains(track_id) {
            return false;
        }
        this.tracks.push(track_id);
        return true;
    }

    public fun remove(track_id: string): bool {
        return this.tracks.remove(track_id);
    }
}
