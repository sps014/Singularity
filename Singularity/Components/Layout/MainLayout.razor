@inherits LayoutComponentBase

<div class="layout">
    <div class="child">
        @Body
    </div>
    <NavMenu />
</div>


<style>

    .layout {
        position: relative;
        overflow: hidden;
        height: 100vh;
        width: 100%;
    }

        .layout .child {
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            height: calc(100% - 60px);
            width: 100%;
            transition: opacity 0.4s ease;
        }

    body, html {
        background: url(https://img.freepik.com/free-vector/abstract-background-design_1107-155.jpg?w=1380&t=st=1720851762~exp=1720852362~hmac=b18842421e00777934a2d7228db1c7fb4b953d9bb688ae21f52460a3cc938a8d) no-repeat center center fixed;
        -webkit-background-size: cover;
        -moz-background-size: cover;
        -o-background-size: cover;
        background-size: cover;
        text-align: center;
        overflow-x: hidden;
    }
</style>