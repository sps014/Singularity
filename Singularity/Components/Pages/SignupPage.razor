@page "/signup"
@using System.Net.Mail
@using System.Text.RegularExpressions
@inject IJSRuntime runtime
@inject NavigationManager Nav
@inject IAuthenticatonService AuthService

<div style="display:flex;height:100vh;display:flex;justify-content:center;align-items:center">
    <Glass Style="border-radius:30px;padding:10px 10px" Blur="10"
           BackgroundColor="rgba(0, 0, 109,0.1)" Border="1px solid rgba(120, 0, 0,0.1)">

        <div>
            <div id="algn">
                <div id="container">
                    <p class="head">Signup</p>
                    <div class="input-container">
                        <input @bind-value="email" type="email" placeholder="Enter email"
                               class="inpt" @oninput="OnEmailChanged" required>
                        <input @bind-value="password" type="password" placeholder="Enter password"
                               class="inpt" @oninput="OnPasswordChanged">

                        <button @onclick="Signup"
                                value="submit" class="btn" style="color:white;background-color:orange;margin-top:10px">
                            Signup
                        </button>
                        <p style="text-align:center;color:yellow">@error</p>
                    </div>

                    <button value="submit" class="btn" style="width:150px;color:black" @onclick="GoToLogin">Login</button>
                </div>
            </div>
        </div>
    </Glass>
</div>

@code
{
    private string email = string.Empty;
    private string password = string.Empty;
    private string error = string.Empty;

    void OnEmailChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        email = e.Value.ToString()!;
        OnInputChanged(e);
    }
    void OnPasswordChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        password = e.Value.ToString()!;
        OnInputChanged(e);
    }

    void OnInputChanged(ChangeEventArgs e)
    {
        SetError(Validate());
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }

    bool SetError((bool IsValid, string? Error) result)
    {
        error = result.IsValid ? string.Empty : result.Error!;
        StateHasChanged();
        return result.IsValid;
    }

    private async void Signup()
    {
        if (!SetError(Validate()))
            return;

        try
        {
            var user = await AuthService.CreateUserAsync(email, password);
            Nav.NavigateTo("/");
        }
        catch (Exception e)
        {
            error = e.Message;
            StateHasChanged();
        }
    }

    private (bool IsValid, string? Error) Validate()
    {
        if (email == null || email.Length < 2 || !IsValidEmail(email))
            return (false, "Invalid email entered");

        if (password == null || password.Length < 6)
            return (false, "Invalid password entered please ensure minimum 6 characters are there ");

        return (true, null);
    }
    private bool IsValidEmail(string emailaddress)
    {
        return Regex.IsMatch(emailaddress, @"^([\w-\.]+)@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$");

    }
}
